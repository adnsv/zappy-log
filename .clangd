# clangd (Cursor, VS Code): read the flags CMake uses. Configure once into
# build/ to create build/compile_commands.json:
#   cmake -S . -B build -G Ninja
# -std=c++20 is added because CMake omits it for compilers whose default
# already satisfies C++20 (GCC 16), and clangd would then assume C++14.
CompileFlags:
  CompilationDatabase: build
  Add: [-std=c++20]
